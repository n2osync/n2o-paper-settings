{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2018",
    "moduleResolution": "bundler",
    "allowJs": false,
    "noImplicitAny": true,
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "importHelpers": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2018"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
